pkgname=omarchy-preview
pkgver=0.7.0
pkgrel=3
pkgdesc='Fast image & PDF preview and effortless printing for Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/VivatVibe/omarchy-preview'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'poppler-qt6' 'xdg-desktop-portal' 'cups')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omarchy-preview "$pkgdir/usr/bin/omarchy-preview"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/omarchy-preview.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omarchy-preview.svg"
  install -Dm644 "$startdir/omarchy-preview.desktop" "$pkgdir/usr/share/applications/omarchy-preview.desktop"
}
