pkgname=peek
pkgver=0.2.0
pkgrel=1
pkgdesc='Fast image preview and effortless printing for Omarchy'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'xdg-desktop-portal' 'cups')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/peek "$pkgdir/usr/bin/peek"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/peek.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/peek.svg"
  install -Dm644 "$startdir/peek.desktop" "$pkgdir/usr/share/applications/peek.desktop"
}
